{
  "name": "devflow-crm",
  "version": "1.0.0",
  "private": true,
  "description": "DevFlow CRM - Enterprise CRM & Workflow Management Platform",
  "scripts": {
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:migrate:undo": "npm --prefix server run db:migrate:undo",
    "db:migrate:undo:all": "npm --prefix server run db:migrate:undo:all",
    "db:seed": "npm --prefix server run db:seed",
    "db:seed:undo": "npm --prefix server run db:seed:undo",
    "db:reset": "npm --prefix server run db:reset"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
